# Copy to /etc/noc-gateway/gateway.env on the VPS (root:gateway, chmod 640).
# Never commit real values.

# Alpaca paper trading credentials (https://app.alpaca.markets)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Grafana service-account token used by the chaos controller to post annotations
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_API_TOKEN=your_grafana_service_account_token

# Optional overrides (defaults shown)
#SYMBOLS=AAPL,SPY,TSLA
#REDIS_URL=redis://127.0.0.1:6379/0
#STREAM_KEY=md.ticks
#STREAM_MAXLEN=100000
#INGRESS_METRICS_PORT=9101
#FIX_METRICS_PORT=9102
#CHAOS_PORT=9103
#FIX_TCP_PORT=5001

# Telemetry gating
#GATE_TRAFFIC_ON_MARKET_HOURS=1   # set 0 to ignore market hours in gateway_traffic_expected
#CHAOS_MAX_DURATION_S=3600        # longest fault duration, used by startup cleanup

# Simulation options for off-hours testing / screenshot runs
#SIMULATE_FEED=1                  # generate fake ticks locally instead of Alpaca
#SIMULATE_FEED_RATE=50            # messages per second in synthetic mode
#FORCE_MARKET_OPEN=1              # force US Market Open panel to OPEN
