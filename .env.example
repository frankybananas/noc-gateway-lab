# Copy to /etc/noc-gateway/gateway.env on the VPS (root:gateway, chmod 640).
# Never commit real values.

# Alpaca paper trading credentials (https://app.alpaca.markets)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Grafana service-account token used by the chaos controller to post annotations
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_API_TOKEN=your_grafana_service_account_token

# Optional overrides (defaults shown)
#SYMBOLS=AAPL,SPY,TSLA
#REDIS_URL=redis://127.0.0.1:6379/0
#STREAM_KEY=md.ticks
#STREAM_MAXLEN=100000
#INGRESS_METRICS_PORT=9101
#FIX_METRICS_PORT=9102
#CHAOS_PORT=9103
#FIX_TCP_PORT=5001
